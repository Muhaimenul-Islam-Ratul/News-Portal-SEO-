# VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# Vite-এ client-side env variable অবশ্যই VITE_ দিয়ে শুরু হতে হবে।
# Vercel Dashboard → Project → Settings → Environment Variables এ এটি যোগ করুন।
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this app is hosted.
# Vercel deploy হলে এটি আপনার Vercel URL হবে।
APP_URL="https://news-portal-seo.vercel.app"
